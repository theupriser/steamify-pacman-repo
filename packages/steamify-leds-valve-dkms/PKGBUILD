# Maintainer: theupriser
# Credit: the DKMS packaging of this driver is Adam Honse's (CalcProgrammer1; the AUR package leds-valve-dkms-git and
# https://gitlab.com/CalcProgrammer1/leds-valve-dkms, GPL-2.0-only); the driver itself (leds-valve.c, GPL-2.0+) is Valve's,
# from SteamOS's kernel (identical to drivers/leds/rgb/leds-valve.c of evlaV/linux-integration 7.2/integration, checked 2026-10-28).
# It is the Steam Machine's front LED bar driver as a DKMS module, pinned to a commit of Adam Honse's repository, which this
# package replaces (leds-valve-dkms-git). The module builds for the kernel DKMS names, not the running one (the Makefile's
# KVERSION), so the dkms.conf here overrides MAKE.
pkgname=steamify-leds-valve-dkms
_dkms=leds-valve-dkms
_commit=c34a0353c8af991bfd3610b6686fe0a8482870b4
pkgver=0.1
pkgrel=1
pkgdesc='Steam Machine front LED bar driver (leds-valve, DKMS)'
arch=(any)
url=https://gitlab.com/CalcProgrammer1/leds-valve-dkms
license=('GPL-2.0-only')
depends=(dkms)
makedepends=(git)
provides=(leds-valve-dkms)
conflicts=(leds-valve-dkms leds-valve-dkms-git)
replaces=(leds-valve-dkms-git)
source=("leds-valve-dkms::git+https://gitlab.com/CalcProgrammer1/leds-valve-dkms.git#commit=$_commit")
sha256sums=('SKIP')

package() {
  local dir="$pkgdir/usr/src/$_dkms-$pkgver"
  cd leds-valve-dkms
  install -Dm644 src/leds-valve.c "$dir/leds-valve.c"
  install -Dm644 src/Makefile "$dir/Makefile"
  cat > "$srcdir/dkms.conf" <<EOF
PACKAGE_NAME="$_dkms"
PACKAGE_VERSION="$pkgver"
BUILT_MODULE_NAME[0]="leds-valve"
MAKE[0]="make KVERSION=\${kernelver}"
DEST_MODULE_LOCATION[0]="/kernel/drivers/leds/rgb"
AUTOINSTALL="yes"
EOF
  install -Dm644 "$srcdir/dkms.conf" "$dir/dkms.conf"
  [ -f LICENSE ] && install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  return 0
}
