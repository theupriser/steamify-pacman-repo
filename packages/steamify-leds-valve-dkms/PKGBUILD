# Maintainer: theupriser
# Credit: Adam Honse (CalcProgrammer1), the creator of OpenRGB (https://openrgb.org, https://gitlab.com/CalcProgrammer1/OpenRGB),
# packaged this driver for DKMS: https://gitlab.com/CalcProgrammer1/leds-valve-dkms (commit c34a0353c8af991bfd3610b6686fe0a8482870b4,
# tag release_0.1; GPL-2.0-only) and the AUR package leds-valve-dkms-git, which this package replaces. The driver itself
# (leds-valve.c, SPDX GPL-2.0+, Copyright (C) 2025 Valve Corporation) is Valve's, from SteamOS's kernel; the file is identical to
# drivers/leds/rgb/leds-valve.c of evlaV/linux-integration 7.2/integration (checked 2026-10-28).
# leds-valve.c and the Makefile are copies of that commit's src/ files (kept here so building this package does not need
# GitLab): if upstream changes, copy the new files and update the commit above. It is the Steam Machine's front LED bar driver
# as a DKMS module. The module builds for the kernel DKMS names, not the running one (the Makefile's KVERSION), so the
# dkms.conf made here overrides MAKE.
pkgname=steamify-leds-valve-dkms
_dkms=leds-valve-dkms
pkgver=0.1
pkgrel=1
pkgdesc='Steam Machine front LED bar driver (leds-valve, DKMS)'
arch=(any)
url=https://gitlab.com/CalcProgrammer1/leds-valve-dkms
license=('GPL-2.0-only')
depends=(dkms)
provides=(leds-valve-dkms)
conflicts=(leds-valve-dkms leds-valve-dkms-git)
replaces=(leds-valve-dkms-git)
source=(leds-valve.c Makefile)
sha256sums=('f3938d976b7385e83aa828357aecc6ab520c50ac34775823c354f361fb14b186' '5b3beaf85bebf1d61c7e2b0deaab3661d2170dba207e446d48a519f741361b6f')

package() {
  local dir="$pkgdir/usr/src/$_dkms-$pkgver"
  install -Dm644 leds-valve.c "$dir/leds-valve.c"
  install -Dm644 Makefile "$dir/Makefile"
  cat > "$dir/dkms.conf" <<EOF
PACKAGE_NAME="$_dkms"
PACKAGE_VERSION="$pkgver"
BUILT_MODULE_NAME[0]="leds-valve"
MAKE[0]="make KVERSION=\${kernelver}"
DEST_MODULE_LOCATION[0]="/kernel/drivers/leds/rgb"
AUTOINSTALL="yes"
EOF
  chmod 644 "$dir/dkms.conf"
}
