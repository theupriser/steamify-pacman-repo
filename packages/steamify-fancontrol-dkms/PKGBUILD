# Maintainer: theupriser
# Credit: Toxican (https://github.com/Toxican) found out what a Steam Machine (Fremont) needs for its fan, built and tested the
# whole fan control module on a real one and contributed it (theupriser/steamify-cachyos#140, #141), including this Makefile and
# dkms.conf. The driver sources were taken from firlin123's steamdeck-dkms (https://github.com/firlin123/steamdeck-dkms).
# The drivers themselves are Valve's: steamdeck.c and steamdeck_hwmon.c (GPL-2.0+, Copyright (C) 2021-2022 Valve Corporation),
# from firlin123/steamdeck-dkms commit 99737c4, which follows Valve's linux-integration tree (evlaV/linux-integration);
# SteamOS's own kernels (linux-neptune) ship both modules. If upstream changes, copy the new files, update the checksums and bump
# pkgver. For the Steam Machine's fan monitoring and, with jupiter-fan-control, the OS fan control.
# The Makefile and dkms.conf build only the modules the target kernel does not provide itself (CONFIG_MFD_STEAMDECK,
# CONFIG_SENSORS_STEAMDECK): a kernel with both builds nothing (DKMS skips it, status 77). dkms.conf leaves
# BUILD_EXCLUSIVE_KERNEL unset when pacman's DKMS hook sources it without a kernel, so the hook builds for every kernel.
pkgname=steamify-fancontrol-dkms
_dkms=steamify-fancontrol
pkgver=1
pkgrel=1
pkgdesc="Steam Machine fan monitoring and control drivers (Valve's steamdeck and steamdeck_hwmon, DKMS)"
arch=(any)
url=https://github.com/theupriser/steamify-pacman-repo
license=('GPL-2.0-or-later')
depends=(dkms)
source=(steamdeck.c steamdeck_hwmon.c Makefile dkms.conf)
sha256sums=('c5bd4be144bbfc8833384eae795178cd308c8dcba0e593b387100361cba9c86c'
            '54dbd7673f8b48b7f8737d5f1213e4863dc7a2a3b94de9b60ab4bb4a7b15290c'
            'SKIP' 'SKIP')

package() {
  local dir="$pkgdir/usr/src/$_dkms-$pkgver"
  install -Dm644 steamdeck.c "$dir/steamdeck.c"
  install -Dm644 steamdeck_hwmon.c "$dir/steamdeck_hwmon.c"
  install -Dm644 Makefile "$dir/Makefile"
  sed -e "s/@NAME@/$_dkms/g" -e "s/@VERSION@/$pkgver/g" dkms.conf | install -Dm644 /dev/stdin "$dir/dkms.conf"
}
